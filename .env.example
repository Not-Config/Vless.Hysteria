# Tested/pinned images
XRAY_IMAGE=ghcr.io/xtls/xray-core:26.9.8
HYSTERIA_IMAGE=tobyxdd/hysteria:v2.12.2
NGINX_IMAGE=nginx:1.30.4-alpine

# VLESS profile:
#   reality   - Xray listens directly on the public TCP port and uses REALITY.
#   web-xhttp - nginx serves HTTPS and routes one XHTTP path to Xray.
VLESS_MODE=reality

# Internal/public listeners on the server.
# TCP and UDP may use the same port number.
VLESS_LISTEN_PORT=443
VLESS_XHTTP_BACKEND_PORT=10000
VLESS_XHTTP_PATH=/api/v1/stream
HY2_LISTEN_PORT=443

# Address/ports placed into generated client links.
# These may differ from the listen ports when the server is behind NAT.
PUBLIC_HOST=203.0.113.10
PUBLIC_VLESS_PORT=443
PUBLIC_HY2_PORT=443

# REALITY camouflage target, used only in reality mode.
REALITY_SNI=www.yandex.ru
REALITY_DEST=www.yandex.ru
REALITY_FINGERPRINT=chrome

# Hysteria2 certificate identity and website SNI.
# For letsencrypt mode, HY2_SNI and WEB_DOMAIN must be the same real DNS name.
HY2_SNI=vpn.example.invalid
WEB_DOMAIN=vpn.example.invalid

# Shared certificate used by nginx and Hysteria2:
#   selfsigned  - portable lab certificate with Hysteria pinning;
#   letsencrypt - publicly trusted certificate obtained with HTTP-01 on TCP/80.
TLS_CERT_MODE=selfsigned
ACME_EMAIL=

# Camouflage site used by web-xhttp.
#   local         - serve web/index.html from this project.
#   reverse-proxy - relay read-only GET/HEAD requests to an HTTPS origin.
CAMOUFLAGE_MODE=local
CAMOUFLAGE_UPSTREAM=https://prime-top.ru

# Local HTTP endpoint used as Hysteria2 masquerade by default.
WEB_LOCAL_PORT=8080
WEB_ALLOW_INSECURE=1
HY2_MASQUERADE=http://127.0.0.1:8080/

# Certificate lifetime for self-signed mode only.
HY2_CERT_DAYS=3650

# Initial user created by install.sh
INITIAL_USER=default
