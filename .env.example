# Tested/pinned images
XRAY_IMAGE=ghcr.io/xtls/xray-core:26.9.8
HYSTERIA_IMAGE=tobyxdd/hysteria:v2.12.2
NGINX_IMAGE=nginx:1.30.4-alpine

# VLESS profile:
#   reality  - Xray listens directly on the public TCP port and uses REALITY.
#   web-grpc - nginx serves a normal HTTPS site and sends one gRPC path to Xray.
VLESS_MODE=reality

# Internal/public listeners on the server.
# TCP and UDP may use the same port number.
VLESS_LISTEN_PORT=443
VLESS_GRPC_BACKEND_PORT=10000
VLESS_GRPC_SERVICE=api/v1/stream
HY2_LISTEN_PORT=443

# Address/ports placed into generated client links.
# These may differ from the listen ports when the server is behind NAT.
PUBLIC_HOST=203.0.113.10
PUBLIC_VLESS_PORT=443
PUBLIC_HY2_PORT=443

# REALITY camouflage target, used only in reality mode.
REALITY_SNI=www.yandex.ru
REALITY_DEST=www.yandex.ru
REALITY_FINGERPRINT=chrome

# Hysteria2 certificate identity.
HY2_SNI=vpn.example.invalid

# Local website used as Hysteria2 masquerade by default.
# In web-grpc mode WEB_DOMAIN is also the public HTTPS SNI handled by nginx.
WEB_DOMAIN=vpn.example.invalid
WEB_LOCAL_PORT=8080
WEB_ALLOW_INSECURE=1
HY2_MASQUERADE=http://127.0.0.1:8080/

# Certificate lifetime for the generated Hysteria2/web certificate.
HY2_CERT_DAYS=3650

# Initial user created by install.sh
INITIAL_USER=default
