# Tested/pinned images
XRAY_IMAGE=ghcr.io/xtls/xray-core:26.9.8
HYSTERIA_IMAGE=tobyxdd/hysteria:v2.12.2

# Internal listeners on the server.
# TCP and UDP may use the same port number.
VLESS_LISTEN_PORT=443
HY2_LISTEN_PORT=443

# Address/ports placed into generated client links.
# These may differ from the listen ports when the server is behind NAT.
PUBLIC_HOST=203.0.113.10
PUBLIC_VLESS_PORT=443
PUBLIC_HY2_PORT=443

# REALITY camouflage target and client TLS ClientHello fingerprint.
# REALITY_DEST normally points to the same real TLS 1.3 site used by REALITY_SNI.
REALITY_SNI=www.yandex.ru
REALITY_DEST=www.yandex.ru
REALITY_FINGERPRINT=chrome

# Hysteria2 self-signed certificate identity and masquerade upstream.
HY2_SNI=vpn.example.invalid
HY2_MASQUERADE=https://www.yandex.ru/

# Certificate lifetime for the portable self-signed Hysteria2 certificate.
HY2_CERT_DAYS=3650

# Initial user created by install.sh
INITIAL_USER=default
